cff-version: 1.2.0
message: "If you use or refer to IMXO, please cite the project using the metadata from this file."
title: "IMXO — Image Model eXchange Object"
authors:
  - family-names: "Malkov"
    given-names: "Fedor"
    orcid: "https://orcid.org/0000-0002-7905-4145"
url: "https://imxo.org"
abstract: "IMXO is an open structured image format and standard for combining visual content with related machine-readable information in a single extensible object."
keywords:
  - "structured image"
  - "image format"
  - "machine-readable data"
  - "provenance"

